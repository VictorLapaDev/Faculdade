# ==========================================
# CONFIGURAÇÕES DO VS CODE
# ==========================================
.vscode/
*.code-workspace
.history/

# ==========================================
# PYTHON
# ==========================================
# Caches de compilação do Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais (caso crie algum para instalar bibliotecas)
venv/
.venv/
env/
/env/
/venv/

# Perfil de testes e cobertura de código
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# JUPYTER NOTEBOOKS
# ==========================================
# Arquivos temporários e checkpoints que o Jupyter cria sozinho
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ==========================================
# ARQUIVOS TEMPORÁRIOS DO SISTEMA OPERACIONAL
# ==========================================
# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini

# ==========================================
# ARQUIVOS DE DADOS PESADOS (DATABASES & DATASETS)
# ==========================================
# Formatos binários e colunares
*.parquet
*.feather
*.orc
*.avro

# Bancos de dados locais e dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdb
*.accdb
*.sql

# Datasets pesados (opcional: remova se precisar salvar dados pequenos no Git)
*.csv
*.tsv
*.xlsx
*.ods

# ==========================================
# COMPACTADOS E MÍDIAS
# ==========================================
*.zip
*.tar
*.gz
*.7z
*.rar
*.pdf

# ==========================================
# MODELOS DE MACHINE LEARNING & PESOS
# ==========================================
*.pkl
*.pickle
*.h5
*.keras
*.onnx
*.pt
*.pth
*.bin